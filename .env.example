# Copy to .env on luma001 and fill in.

# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# The public hostname Old Shit is served on (must match the Caddy block).
OLDSHIT_HOST=oldshit.example.com

# Host port the stack publishes on 127.0.0.1 (change if 8020 is taken).
OLDSHIT_PORT=8020
